{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "server",
    "outDir": "server/dist"
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "server/dist"]
}
