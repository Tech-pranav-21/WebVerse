{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": [
    "src/types/camera.ts",
    "src/services/streamConnectionService.ts",
    "src/services/streamTransports.ts",
    "src/services/streamStatusText.ts",
    "src/services/mjpegParser.ts",
    "src/services/connectionService.ts",
    "src/services/redact.ts",
    "src/services/connectionHistory.ts",
    "src/services/diagnosticsSummary.ts",
    "src/services/diagnosticReport.ts",
    "src/services/clipboard.ts",
    "src/services/frameCapture.ts",
    "src/services/snapshotStorage.ts",
    "src/services/snapshotLibrary.ts",
    "src/services/snapshotDownload.ts",
    "src/services/snapshotActions.ts",
    "src/services/motionSettings.ts",
    "src/services/motionDetector.ts",
    "src/services/frameSampler.ts",
    "src/services/motionHistory.ts",
    "src/services/motionMonitor.ts",
    "src/services/confirmGate.ts",
    "src/services/aiSettings.ts",
    "src/services/aiClient.ts",
    "src/services/aiHistory.ts",
    "src/services/aiRecognizer.ts",
    "src/services/motionEventBus.ts",
    "src/services/snapshotLinkText.ts",
    "src/types/ai.ts",
    "src/types/pose.ts",
    "src/services/poseErrors.ts",
    "src/services/poseResponse.ts",
    "src/services/poseClient.ts",
    "src/services/poseSettings.ts",
    "src/services/activityPresentation.ts",
    "src/services/deploymentMode.ts",
    "src/components/DeploymentModeBanner.tsx",
    "src/components/ActivityRecognitionSection.tsx",
    "src/components/PoseKeypointInspector.tsx",
    "src/components/PoseEstimationPanel.tsx",
    "server/protocol.ts",
    "server/config.ts",
    "server/redact.ts",
    "server/image.ts",
    "server/prompt.ts",
    "server/normalize.ts",
    "server/limits.ts",
    "server/groqClient.ts",
    "server/app.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".test-build",
    "dist"
  ]
}
