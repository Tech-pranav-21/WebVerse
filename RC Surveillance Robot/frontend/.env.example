# ==============================================================================
# ESP32-CAM Surveillance Configuration (Default Client Environment Variables)
# ==============================================================================
# Base URL where your ESP32-CAM web server is accessible on your local network.
# Example: "http://192.168.1.100" or "http://192.168.4.1" (ESP32 AP mode)
VITE_CAMERA_BASE_URL="http://192.168.1.100"

# Confirmed continuous video stream endpoint / path.
# Leave empty ("") by default until your physical robot's stream route is confirmed!
# Common ESP32-CAM routes once verified:
# - Standard Arduino CameraWebServer sketch: ":81/stream"
# - Single-port web server: "/stream"
# - MJPEG route: "/mjpeg"
VITE_CAMERA_STREAM_PATH=""

# Confirmed single-frame snapshot endpoint / path.
# Common ESP32-CAM default for OV2640 captures: "/capture"
VITE_CAMERA_SNAPSHOT_PATH="/capture"

# ==============================================================================
# SERVER-SIDE ONLY: Groq AI recognition backend (run it with `npm run server`)
# ==============================================================================
# These variables are read by the small Node backend in server/ and are NEVER sent to the
# browser. Do NOT rename them with a VITE_ prefix: Vite would then put them into the web page.
# Copy this file to .env (which is git-ignored) and fill in the key there; never commit it.
#
# Your Groq API key (create one at https://console.groq.com/keys). Leave empty to keep AI
# recognition switched off: the dashboard then reports "not configured".
GROQ_API_KEY=
# Vision model. qwen/qwen3.8-27b is the Groq vision model documented as available on 2026-10-21;
# Groq labels it "Preview" (it may change or be withdrawn at short notice).
GROQ_MODEL=qwen/qwen3.8-27b
# Where the backend listens. Keep 127.0.0.1 unless you understand that anyone who can reach the
# port can spend your Groq quota (the limits below still apply).
AI_SERVER_PORT=8787
AI_SERVER_HOST=127.0.0.1
# Limits that protect your Groq quota. Requests per rolling minute / per rolling 24 h, in total.
AI_RATE_PER_MINUTE=6
AI_MAX_PER_DAY=100
# Largest JPEG accepted, in bytes (camera frames are typically 20 to 60 kB).
AI_MAX_IMAGE_BYTES=1500000
# Timeout for one Groq request (milliseconds) and how many times a transient error is retried.
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
# Extra browser origins allowed to call the backend, comma separated. Pages served from
# localhost / 127.0.0.1 / [::1] are always allowed.
AI_ALLOWED_ORIGINS=
