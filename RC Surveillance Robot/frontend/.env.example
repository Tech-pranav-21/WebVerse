# ==============================================================================
# ESP32-CAM Surveillance Configuration (Default Client Environment Variables)
# ==============================================================================
# Base URL where your ESP32-CAM web server is accessible on your local network.
# Example: "http://192.168.1.100" or "http://192.168.4.1" (ESP32 AP mode)
VITE_CAMERA_BASE_URL="http://192.168.1.100"

# Confirmed continuous video stream endpoint / path.
# Leave empty ("") by default until your physical robot's stream route is confirmed!
# Common ESP32-CAM routes once verified:
# - Standard Arduino CameraWebServer sketch: ":81/stream"
# - Single-port web server: "/stream"
# - MJPEG route: "/mjpeg"
VITE_CAMERA_STREAM_PATH=""

# Confirmed single-frame snapshot endpoint / path.
# Common ESP32-CAM default for OV2640 captures: "/capture"
VITE_CAMERA_SNAPSHOT_PATH="/capture"

# ==============================================================================
# SERVER-SIDE ONLY: AI Recognition Backend (run it with `npm run server`)
# ==============================================================================
# These variables are read by the small Node backend in server/ and are NEVER sent to the
# browser. Do NOT rename them with a VITE_ prefix: Vite would then put them into the web page.
# Copy this file to .env (which is git-ignored) and fill in the keys there; never commit it.

# ------------------------------------------------------------------------------
# GROQ  (https://console.groq.com/keys)
# Ultra-fast LPU inference with Qwen/Llama vision models.
# ------------------------------------------------------------------------------
GROQ_API_KEY=
# Vision model — qwen/qwen3.8-27b is the documented Groq vision model (Preview as of 2026-10-21)
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# GOOGLE GEMINI  (https://aistudio.google.com/apikey)
# Multimodal vision models from Google DeepMind.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# OPENAI  (https://platform.openai.com/api-keys)
# Industry-standard GPT vision models.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Active provider — which key the backend uses when the frontend sends a request.
# Value: groq | gemini | openai
# If not set, auto-selected based on which key is configured (Groq preferred).
# ------------------------------------------------------------------------------
ACTIVE_AI_PROVIDER=groq

# ==============================================================================
# Backend Networking
# ==============================================================================
# Where the backend listens. Keep 127.0.0.1 unless you understand that anyone who
# can reach the port can spend your AI quota (the limits below still apply).
# Do not use 3000: it is the dashboard's own dev-server port (npm run dev).
AI_SERVER_PORT=8787
AI_SERVER_HOST=127.0.0.1

# ==============================================================================
# Backend Rate Limits
# ==============================================================================
# Requests per rolling minute / per rolling 24 h, in total across all clients.
AI_RATE_PER_MINUTE=6
AI_MAX_PER_DAY=100
# Largest JPEG accepted, in bytes (camera frames are typically 20 to 60 kB).
AI_MAX_IMAGE_BYTES=1500000
# Timeout for one upstream AI request (milliseconds) and how many times a
# transient error is retried (not for timeouts).
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
# Extra browser origins allowed to call the backend, comma separated.
# Pages served from localhost / 127.0.0.1 / [::1] are always allowed.
AI_ALLOWED_ORIGINS=

# ==============================================================================
# Python pose / activity service (activity-recognition/)
# ==============================================================================
# The Python service does NOT read this file: set these in the shell that starts it, if you need
# them. Only POSE_SERVICE_PORT is also read here, by vite.config.ts, to aim the /api/pose proxy.
# (All other settings, including the HAR_* tuning values, are listed in activity-recognition/config.py.)
#
# POSE_SERVICE_HOST=127.0.0.1          # keep it on loopback
# POSE_SERVICE_PORT=8000
# POSE_ALLOWED_ORIGINS=                # extra browser origins allowed to call it (comma separated);
#                                      # localhost / 127.0.0.1 / [::1] pages are always allowed; "*" is ignored
# POSE_DEVICE=auto                     # auto | cuda | cpu

# ==============================================================================
# Public demo build (npm run build:demo)
# ==============================================================================
# Everything starting with VITE_ is written into the web page that is published. The demo build
# therefore ignores VITE_CAMERA_BASE_URL (your camera's address must never be published) and
# starts with no camera. It needs no environment variables, and it must never be given any AI keys.
# Optional public contact link shown in the demo (https://... or mailto:...). Do not put a secret here.
VITE_PROJECT_CONTACT_URL=
